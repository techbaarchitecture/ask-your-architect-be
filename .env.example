# Run npm run setup to generate real random values into mode-0600 .env.
PORT=4100
HOST=127.0.0.1
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Exactly 32 random bytes encoded as 64 hex characters; generated by setup.
ENCRYPTION_KEY=
DATABASE_PATH=./data/app.sqlite
# Exact comma-separated origins; add deployed frontend origin explicitly.
ALLOWED_ORIGINS=http://localhost:5178
# Set true only for a trusted local 9router/private provider. Metadata still denied.
ALLOW_PRIVATE_PROVIDER=false
# Provider API keys are entered via authenticated admin settings, not seeded here.
# Optional backend-only accepted architecture-chat archive. Enable URL + token together.
# Keep the token private; never put these settings in the frontend or admin settings.
# NOCOBASE_API_URL=https://dev.baarchitecture.cloud/api
# NOCOBASE_API_TOKEN=
# NOCOBASE_CHAT_COLLECTION=aya_architecture_chats
